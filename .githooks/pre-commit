#!/bin/bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
cache="$PWD/.build/pre-commit"
snapshot="$(mktemp -d)"
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"
mkdir -p "$cache/source"
rsync --archive --checksum --delete --exclude node_modules "$snapshot/" "$cache/source/"
swift build -c release --package-path "$cache/source/app" --scratch-path "$cache/scratch" \
  -Xswiftc -warnings-as-errors
(cd analyzer && bunx tsc --noEmit -p . && bun test)
