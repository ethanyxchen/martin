{
  "$schema": "https://supaterm.com/schema/supaterm.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "git config core.hooksPath .githooks && mise trust --yes && mise install",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Run Martin",
      "command": "mise run dev",
      "icon": "play"
    },
    {
      "name": "Test",
      "command": "mise run test",
      "icon": "test"
    },
    {
      "name": "Lint",
      "command": "mise run lint",
      "icon": "lint"
    },
    {
      "name": "Clean Up",
      "command": "mise run clean",
      "icon": "build",
      "runOnDone": true
    }
  ]
}
